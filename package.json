{
  "name": "@ttdua/pi-subagents",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./src/service/service.ts"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./src/layered-settings.ts"
    }
  },
  "files": [
    "src",
    "agents",
    "dist",
    "docs/*.md",
    "docs/architecture/*.md",
    "docs/decisions",
    "CHANGELOG.md",
    "NOTICE.md",
    "UPSTREAM.md"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "description": "A focused, in-process sub-agent core for pi \u2014 autonomous agents plus a typed API and lifecycle events other extensions build on. Fork of @gotgenes/pi-subagents with launch policy, metadata, resources and markdown built-in agents.",
  "author": {
    "name": "ttdua"
  },
  "contributors": [
    "Chris Lasher (upstream @gotgenes/pi-subagents)",
    "tintinweb (original tintinweb/pi-subagents)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttdua/pi-subagents.git"
  },
  "homepage": "https://github.com/ttdua/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/ttdua/pi-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": "*"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:types": "rollup -c rollup.dts.config.mjs",
    "prepack": "bun run build:types",
    "verify:public-types": "bash scripts/verify-public-types.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:md": "rumdl check .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.15.3",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rumdl": "0.2.24",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    },
    "image": "https://raw.githubusercontent.com/ttdua/pi-subagents/main/docs/assets/demo.webp"
  },
  "private": true
}
